# FlySupa environment variables.
# VITE_* vars are exposed to the browser bundle. The anon keys are PUBLIC by
# design (they ship in the bundle) — safe to commit. Service-role keys are NOT.

# ---------------------------------------------------------------------------
# DEV — used automatically by `npm run dev` (Vite mode=development loads
# .env.development, which is committed and points at the hosted Supabase
# `development` branch).
#   VITE_SUPABASE_URL=https://pyilyqtuswkxwddqbgfu.supabase.co
#   VITE_SUPABASE_ANON_KEY=<see .env.development>
#
# LOCAL DB — used automatically by `npm run dev:local` (Vite mode=localdb loads
# .env.localdb, which is committed and points at local Supabase).
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<local demo key — see .env.localdb>
# ---------------------------------------------------------------------------

# TEST (cloud) — https://jgrlbqryehuawrgohdrj.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PROD (cloud) — https://nihffzcyqgbxpdbrnavr.supabase.co
# (set these in Vercel for deployments; also stored in
#  ~/.hermes/flysupa-environments.json)
